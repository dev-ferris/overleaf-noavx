# ---------------------------------------------------------------------------
# Compose variables (NOT passed to Overleaf)
# Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Project name = prefix of the volume names (e.g. overleaf_mongo_data).
# For an existing installation enter the previous name (usually the name of the old
# compose directory), otherwise Compose creates new, empty volumes!
#   docker volume ls | grep mongo_data
COMPOSE_PROJECT_NAME=overleaf

# Images
OVERLEAF_IMAGE=overleafcep/sharelatex:6.3.0-ext-v5.1
# MongoDB 8.0 without AVX from Docker Hub (identical: ghcr.io/dev-ferris/mongodb-no-avx:8.0.17-nehalem);
# own build: mongodb-no-avx:8.0.17-nehalem; CPU with AVX: mongo:8.0
MONGO_IMAGE=devferris/mongodb-no-avx:8.0.17-nehalem
REDIS_IMAGE=redis:7.4-alpine
# or: valkey/valkey:9.2-alpine
MONGOSH_IMAGE=alpine/mongosh:latest

# WiredTiger cache in GB (if unset, MongoDB uses ~50 % of the RAM)
MONGO_CACHE_GB=1

# Published port of Overleaf ("<port>" or "<ip>:<port>").
# Behind a reverse proxy on the same host: 127.0.0.1:8088
OVERLEAF_BIND=8088

# --- TeX Live ---------------------------------------------------------------
# Source for the texlive volume. Other releases: https://hub.docker.com/r/texlive/texlive/tags
# (e.g. texlive/texlive:TL2025-historic). After a change, texlive-init copies again
# automatically on the next "docker compose up -d".
TEXLIVE_IMAGE=texlive/texlive:latest
