# ---------------------------------------------------------------------------
# Compose-Variablen (werden NICHT an Overleaf durchgereicht)
# Kopieren nach .env und anpassen.
# ---------------------------------------------------------------------------

# Projektname = Präfix der Volume-Namen (z. B. overleaf_mongo_data).
# Bei einer bestehenden Installation den bisherigen Namen eintragen (meist der
# Name des alten Compose-Verzeichnisses), sonst legt Compose neue, leere Volumes an!
#   docker volume ls | grep mongo_data
COMPOSE_PROJECT_NAME=overleaf

# Images
OVERLEAF_IMAGE=overleafcep/sharelatex:6.3.0-ext-v5.1
# MongoDB 8.0 ohne AVX von Docker Hub; Eigenbau: mongodb-no-avx:8.0.17-nehalem; CPU mit AVX: mongo:8.0
MONGO_IMAGE=devferris/mongodb-no-avx:8.0.17-nehalem
REDIS_IMAGE=redis:7.4-alpine
MONGOSH_IMAGE=alpine/mongosh:latest

# WiredTiger-Cache in GB (ohne Angabe nimmt MongoDB ~50 % des RAMs)
MONGO_CACHE_GB=1

# Reverse Proxy (caddy-docker-proxy)
OVERLEAF_HOSTNAME=https://overleaf.example.com
CADDY_NETWORK=caddy

# --- TeX Live ---------------------------------------------------------------
# Quelle für das texlive-Volume. Weitere Jahrgänge: https://hub.docker.com/r/texlive/texlive/tags
# (z. B. texlive/texlive:TL2025-historic). Nach einer Änderung kopiert texlive-init beim
# nächsten "docker compose up -d" automatisch neu.
TEXLIVE_IMAGE=texlive/texlive:latest-full
