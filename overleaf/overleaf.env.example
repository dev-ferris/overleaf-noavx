# ---------------------------------------------------------------------------
# Overleaf configuration (loaded into the sharelatex container via env_file)
# Copy to overleaf.env and adjust. Contains secrets -> do not commit.
# Compose settings (images, port, project name) live separately in .env.
#
# Adjust at least:
#   OVERLEAF_SITE_URL             address under which Overleaf is accessed
#   OVERLEAF_INVITE_TOKEN_SECRET  generate once (openssl rand -base64 32)
#   OVERLEAF_ADMIN_EMAIL          contact address
#
# IMPORTANT: Some Overleaf variables take effect as soon as they are SET –
# regardless of their value. Most prominent example: "OVERLEAF_SECURE_COOKIE=false"
# turns secure cookies ON (settings.js: process.env.OVERLEAF_SECURE_COOKIE != null).
# To switch something off: comment the line out, do not set it to false.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Exactly the URL used in the browser – including port, without trailing "/".
# The port matches OVERLEAF_BIND in .env.
#   direct:              http://overleaf-host.example.com:8088
#   behind HTTPS proxy:  https://overleaf.example.com   (then also set OVERLEAF_SECURE_COOKIE)
OVERLEAF_SITE_URL=http://overleaf-host.example.com:8088

# Required since 6.2, Overleaf does not start without it. Generate once and NEVER change:
#   openssl rand -base64 32
OVERLEAF_INVITE_TOKEN_SECRET=

# Binary files are stored in the project history (since 5.5/6.x). Harmless for a new
# installation; when upgrading, set it only after the binary files migration
# (see docs/migration-5.5-to-6.3.md).
OVERLEAF_FILESTORE_MIGRATION_LEVEL=2

# --- Reverse proxy with HTTPS (optional) ----------------------------------
# Uncomment only when Overleaf is accessed via HTTPS (reverse proxy), and set
# OVERLEAF_SITE_URL to the https address. Do NOT set it for direct HTTP access
# (not even to false!), otherwise: "Session error. Please check you have cookies enabled."
# OVERLEAF_SECURE_COOKIE=true
# In current versions "behindProxy" is always on; the variable is only evaluated by 5.x.
# OVERLEAF_BEHIND_PROXY=true

# --- Appearance -----------------------------------------------------------
OVERLEAF_APP_NAME=Overleaf
OVERLEAF_NAV_TITLE=Overleaf
OVERLEAF_ADMIN_EMAIL=admin@example.com
# Footer links (JSON)
# OVERLEAF_LEFT_FOOTER=[{"text": "Contact", "url": "mailto:admin@example.com"}]
# OVERLEAF_RIGHT_FOOTER=[{"text": "Overleaf CEP", "url": "https://github.com/yu-i-i/overleaf-cep"}]

# --- Features -------------------------------------------------------------
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
# Thumbnails (e.g. for the template gallery)
ENABLE_CONVERSIONS=true
# Useful without SMTP: do not require confirmation emails (checked for exactly "true")
EMAIL_CONFIRMATION_DISABLED=true

# CEP: restore from history snapshots (experimental)
# OVERLEAF_HISTORY_RESTORE=true
# CEP: maximum upload size in MB (default 50)
# MAX_UPLOAD_SIZE=100

# --- CEP: template gallery ------------------------------------------------
OVERLEAF_TEMPLATE_GALLERY=true
OVERLEAF_NON_ADMIN_CAN_PUBLISH_TEMPLATES=false
OVERLEAF_TEMPLATE_CATEGORIES=formal-letter report presentation cv thesis
TEMPLATE_FORMAL_LETTER_NAME=Letters
TEMPLATE_FORMAL_LETTER_DESCRIPTION=Letter templates based on KOMA-Script (scrlttr2)
TEMPLATE_REPORT_NAME=Reports
TEMPLATE_REPORT_DESCRIPTION=Technical reports and project documentation
TEMPLATE_PRESENTATION_NAME=Presentations
TEMPLATE_PRESENTATION_DESCRIPTION=Beamer templates
TEMPLATE_CV_NAME=CVs
TEMPLATE_CV_DESCRIPTION=CV and application templates
TEMPLATE_THESIS_NAME=Theses
TEMPLATE_THESIS_DESCRIPTION=Templates for longer academic works
TEMPLATE_ALL_NAME=All templates
TEMPLATE_ALL_DESCRIPTION=All available templates

# --- LaTeX ----------------------------------------------------------------
# Allow external commands during compilation (e.g. minted). Runs WITHOUT a sandbox directly
# in the Overleaf container -> enable only with trusted users.
# TEX_COMPILER_EXTRA_FLAGS=-shell-escape

# --- Email (optional) -----------------------------------------------------
# Without SMTP no emails are sent; activation links for new users are shown in the
# admin area or by the create-user script.
# OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false        # JSON value: true = TLS from connection start (port 465)
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=
# CEP: read the password from a file instead (e.g. Docker secret)
# OVERLEAF_EMAIL_SMTP_PASS_FILE=/run/secrets/smtp_pass
