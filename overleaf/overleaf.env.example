# ---------------------------------------------------------------------------
# Overleaf-Konfiguration (wird per env_file in den sharelatex-Container geladen)
# Kopieren nach overleaf.env und anpassen. Enthält Secrets -> nicht committen.
#
# WICHTIG: Manche Overleaf-Variablen wirken bereits, wenn sie GESETZT sind –
# unabhängig vom Wert. Prominentestes Beispiel: "OVERLEAF_SECURE_COOKIE=false"
# schaltet Secure-Cookies EIN (settings.js: process.env.OVERLEAF_SECURE_COOKIE != null).
# Was aus sein soll: Zeile auskommentieren, nicht auf false setzen.
# ---------------------------------------------------------------------------

# --- Pflicht --------------------------------------------------------------

# Exakt die URL, unter der Overleaf im Browser aufgerufen wird
OVERLEAF_SITE_URL=https://overleaf.example.com

# Pflicht seit 6.2, Overleaf startet sonst nicht. Einmal erzeugen und NIE ändern:
#   openssl rand -base64 32
OVERLEAF_INVITE_TOKEN_SECRET=

# Binary-File-Migration aus 5.5 ist abgeschlossen (siehe docs/migration-5.5-to-6.3.md)
OVERLEAF_FILESTORE_MIGRATION_LEVEL=2

# --- Reverse Proxy mit HTTPS (Caddy) --------------------------------------
# Nur bei Zugriff über HTTPS setzen. Bei direktem HTTP-Zugriff (http://host:port)
# auskommentieren, sonst: "Session error. Please check you have cookies enabled."
OVERLEAF_SECURE_COOKIE=true
# In aktuellen Versionen ist "behindProxy" fest aktiv; die Variable schadet nicht,
# wird aber von älteren Versionen (5.x) noch ausgewertet.
OVERLEAF_BEHIND_PROXY=true

# --- Darstellung ----------------------------------------------------------
OVERLEAF_APP_NAME=Overleaf
OVERLEAF_NAV_TITLE=Overleaf
OVERLEAF_ADMIN_EMAIL=admin@example.com
# OVERLEAF_LEFT_FOOTER=[{"text": "Homelab", "url": "https://overleaf.example.com"}]

# --- Funktionen -----------------------------------------------------------
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
# Vorschaubilder (u. a. für die Template-Galerie)
ENABLE_CONVERSIONS=true
# Ohne SMTP sinnvoll: keine Bestätigungsmails verlangen (wird exakt auf "true" geprüft)
EMAIL_CONFIRMATION_DISABLED=true

# CEP: Wiederherstellen aus History-Snapshots (experimentell)
# OVERLEAF_HISTORY_RESTORE=true
# CEP: maximale Upload-Größe in MB (Standard 50)
# MAX_UPLOAD_SIZE=100

# --- CEP: Template-Galerie ------------------------------------------------
OVERLEAF_TEMPLATE_GALLERY=true
OVERLEAF_NON_ADMIN_CAN_PUBLISH_TEMPLATES=false
OVERLEAF_TEMPLATE_CATEGORIES=formal-letter report presentation cv thesis
TEMPLATE_FORMAL_LETTER_NAME=Briefe
TEMPLATE_FORMAL_LETTER_DESCRIPTION=Briefvorlagen auf Basis von KOMA-Script (scrlttr2)
TEMPLATE_REPORT_NAME=Berichte
TEMPLATE_REPORT_DESCRIPTION=Technische Berichte und Projektdokumentation
TEMPLATE_PRESENTATION_NAME=Präsentationen
TEMPLATE_PRESENTATION_DESCRIPTION=Beamer-Vorlagen
TEMPLATE_CV_NAME=Lebensläufe
TEMPLATE_CV_DESCRIPTION=CV- und Bewerbungsvorlagen
TEMPLATE_THESIS_NAME=Abschlussarbeiten
TEMPLATE_THESIS_DESCRIPTION=Vorlagen für längere wissenschaftliche Arbeiten
TEMPLATE_ALL_NAME=Alle Vorlagen
TEMPLATE_ALL_DESCRIPTION=Alle verfügbaren Vorlagen

# --- CEP: Sandboxed Compiles ---------------------------------------------
# Aktiviert und mit Images versorgt in docker-compose.yml (TEXLIVE_IMAGE in .env).
# Externe Befehle beim Kompilieren erlauben (z. B. für minted); in der Sandbox vertretbar
# TEX_COMPILER_EXTRA_FLAGS=-shell-escape

# --- E-Mail (optional) ----------------------------------------------------
# OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=
